<rendering>
  <page titleKey="tc_xrt_General">
    <section titleKey="tc_xrt_Properties">
      
      <property name="aw2_status" renderingHint="label" initialValue="HI"/>
      
      <property name="item_revision_id" renderingHint="textfield" modifiable="false"/>
      
      <property name="object_desc" renderingHint="textarea" labelKey="tc_xrt_Description"/>
      
      <property name="aw2_material_type" renderingHint="lovcombobox"/>
      <!-- 달력 -->
      <property name="aw2_date" renderingHint="datepicker"/>
	  <!-- 승인여부 -->
      <property name="aw2_is_approve" renderingHint="togglebutton"/>
      <!-- 승인시 보임 누르면 aw2_approver 상세페이지로 이동 -->
      <property name="aw2_approver" renderingHint="objectlink" visibleWhen="aw2_is_approve == 'True'"/>
    </section>
  </page>
</rendering>